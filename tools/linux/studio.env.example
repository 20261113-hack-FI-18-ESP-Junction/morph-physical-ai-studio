# Trusted local shell configuration. setup.sh copies this to .runtime/linux.env
# only when that file does not exist. Do not store credentials in this template.
HOST=127.0.0.1
PORT=3000
DEBUG=false
ENVIRONMENT=dev
STORAGE_DIR="$MORPH_STUDIO_ROOT/.runtime/studio"
SETTINGS_FILE="$STORAGE_DIR/settings.json"
STATIC_FILES_DIR="$MORPH_STUDIO_ROOT/application/ui/dist"
UV_CACHE_DIR="$MORPH_STUDIO_ROOT/.runtime/uv-cache"
HF_HOME="$MORPH_STUDIO_ROOT/.runtime/huggingface"
HF_LEROBOT_HOME="$MORPH_STUDIO_ROOT/.runtime/lerobot"
XDG_CACHE_HOME="$MORPH_STUDIO_ROOT/.runtime/cache"

# Relative API URLs let the same build work on the Dell and through SSH forwarding.
PUBLIC_API_BASE_URL=''
MORPH_STUDIO_PYTHON=3.13
MORPH_STUDIO_ACCELERATOR=xpu
MORPH_STUDIO_NODE_MIN=24.2.0
MORPH_STUDIO_NPM_MIN=11.14.0
MORPH_STUDIO_SERVICE_NAME=morph-physical-ai-studio
MORPH_STUDIO_READY_TIMEOUT=90
MORPH_STUDIO_MIN_CAMERAS=1
